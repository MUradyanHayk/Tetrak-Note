<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.TetrakNote" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color (Top bar / headers) -->
        <item name="colorPrimary">#0088CC</item> <!-- Telegram Blue -->
        <item name="colorPrimaryVariant">#3390EC</item>
        <item name="colorOnPrimary">#FFFFFF</item>

        <!-- Secondary brand color (Accents, buttons, FAB) -->
        <item name="colorSecondary">#3390EC</item>
        <item name="colorSecondaryVariant">#2478CC</item>
        <item name="colorOnSecondary">#FFFFFF</item>

        <!-- Backgrounds -->
        <item name="android:windowBackground">#FFFFFF</item>
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
    </style>

    <style name="Theme.TetrakNote.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.TetrakNote.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <style name="Theme.TetrakNote.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />
</resources>