<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.TetrakNote" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color (Top bar / headers) -->
        <item name="colorPrimary">#212D3B</item> <!-- Dark bluish gray -->
        <item name="colorPrimaryVariant">#17212B</item> <!-- Even darker variant -->
        <item name="colorOnPrimary">#FFFFFF</item> <!-- White text on dark -->

        <!-- Secondary brand color (Accents, buttons, FAB) -->
        <item name="colorSecondary">#3390EC</item> <!-- Telegram Blue -->
        <item name="colorSecondaryVariant">#2478CC</item>
        <item name="colorOnSecondary">#FFFFFF</item>

        <!-- Backgrounds -->
        <item name="android:windowBackground">#0E1621</item> <!-- Main background -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
    </style>

</resources>